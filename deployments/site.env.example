# Site values for the Kubernetes manifests and benchmark drivers.
#
#   cp deployments/site.env.example deployments/site.env   # git-ignored; edit for your cluster
#   python tools/render_site.py --env deployments/site.env deployments/06-nemotron-3-nano-h200 --out build/site
#   kubectl --context "$KUBE_CONTEXT" apply -f build/site/06-nemotron-3-nano-h200/40-workers-tp4.yaml
#
# Checked-in manifests carry <PLACEHOLDER> tokens instead of real hostnames and
# addresses. render_site.py substitutes every <NAME> listed here and refuses to
# write a file that still contains an unknown placeholder.

# Kubernetes context used by the documented kubectl commands.
KUBE_CONTEXT=<your-kube-context>

# `kubectl get nodes` names of the two GPU nodes (nodeSelector values).
NODE_A_HOSTNAME=<node-a-name>
NODE_B_HOSTNAME=<node-b-name>

# Node InternalIPs. Workers use hostNetwork, so metrics are scraped on these
# addresses. The benchmark drivers read NODE_A_IP / NODE_B_IP from the environment.
NODE_A_IP=<node-a-internal-ip>
NODE_B_IP=<node-b-internal-ip>

# External address of the frontend LoadBalancer Service, for documentation and
# smoke tests only. Do not commit it.
LOADBALANCER_IP=<loadbalancer-ip>
