<mxfile host="tools/render_diagrams.py"><diagram name="KV cache tiers"><mxGraphModel dx="1400" dy="640" grid="1" gridSize="10" page="1" pageWidth="1400" pageHeight="640" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="KV cache tiers" style="html=1;fontFamily=DejaVu Sans;whiteSpace=wrap;text;fontSize=20;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1320" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Each tier down holds more KV and takes longer to bring back into HBM. Only G1 is used by the measured deployments." style="html=1;fontFamily=DejaVu Sans;whiteSpace=wrap;text;fontSize=12;fontColor=#5F6368;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1320" height="24" as="geometry"/></mxCell><mxCell id="c4" value="G1  GPU HBM&#xa;active KV pages for running requests" style="html=1;fontFamily=DejaVu Sans;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#EEF6E0;strokeColor=#76B900;fontColor=#3F6300;dashed=0;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="520" height="84" as="geometry"/></mxCell><mxCell id="c5" value="in use on every engine" style="html=1;fontFamily=DejaVu Sans;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#C4C7CA;fontColor=#5F6368;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="960" y="130" width="400" height="84" as="geometry"/></mxCell><mxCell id="c6" value="G2  Host DRAM&#xa;offloaded prefixes, seconds to reload" style="html=1;fontFamily=DejaVu Sans;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#F3F4F5;strokeColor=#C4C7CA;fontColor=#1A1A1A;dashed=0;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="234" width="610" height="84" as="geometry"/></mxCell><mxCell id="c7" value="roadmap (KV offloading phase 1)" style="html=1;fontFamily=DejaVu Sans;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#C4C7CA;fontColor=#5F6368;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="960" y="234" width="400" height="84" as="geometry"/></mxCell><mxCell id="c8" value="G3  Local NVMe · GPUDirect Storage&#xa;large working sets per node" style="html=1;fontFamily=DejaVu Sans;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#F3F4F5;strokeColor=#C4C7CA;fontColor=#1A1A1A;dashed=0;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="338" width="700" height="84" as="geometry"/></mxCell><mxCell id="c9" value="roadmap (phase 2)" style="html=1;fontFamily=DejaVu Sans;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#C4C7CA;fontColor=#5F6368;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="960" y="338" width="400" height="84" as="geometry"/></mxCell><mxCell id="c10" value="G4  Shared storage&#xa;prefixes reused across nodes" style="html=1;fontFamily=DejaVu Sans;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#F3F4F5;strokeColor=#C4C7CA;fontColor=#1A1A1A;dashed=0;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="442" width="790" height="84" as="geometry"/></mxCell><mxCell id="c11" value="roadmap (phase 3)" style="html=1;fontFamily=DejaVu Sans;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#C4C7CA;fontColor=#5F6368;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="960" y="442" width="400" height="84" as="geometry"/></mxCell><mxCell id="c12" value="" style="html=1;fontFamily=DejaVu Sans;whiteSpace=wrap;endArrow=block;endFill=1;strokeColor=#3C4043;strokeWidth=1.5;dashed=0;fontColor=#5F6368;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="920" y="140" as="sourcePoint"/><mxPoint x="920" y="540" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c13" value="Status in this repository" style="html=1;fontFamily=DejaVu Sans;whiteSpace=wrap;text;fontSize=11;fontColor=#5F6368;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="960" y="104" width="520" height="24" as="geometry"/></mxCell><mxCell id="c14" value="Down the arrow: more capacity per byte of cost, higher latency to reload a prefix. Plan: ROADMAP.md, KV-cache offloading phases 0-3." style="html=1;fontFamily=DejaVu Sans;whiteSpace=wrap;text;fontSize=11;fontColor=#5F6368;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="520" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
