<mxfile host="tools/render_diagrams.py"><diagram name="LLM serving stack"><mxGraphModel dx="1400" dy="760" grid="1" gridSize="10" page="1" pageWidth="1400" pageHeight="760" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="LLM serving stack" style="html=1;fontFamily=DejaVu Sans;whiteSpace=wrap;text;fontSize=20;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1320" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Each layer depends only on the layer below it. The right column shows where this repository configures it." style="html=1;fontFamily=DejaVu Sans;whiteSpace=wrap;text;fontSize=12;fontColor=#5F6368;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1320" height="24" as="geometry"/></mxCell><mxCell id="c4" value="Clients and API edge" style="html=1;fontFamily=DejaVu Sans;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#F3F4F5;strokeColor=#C4C7CA;fontColor=#1A1A1A;dashed=0;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="300" height="84" as="geometry"/></mxCell><mxCell id="c5" value="OpenAI-compatible HTTP · Gateway API + Envoy: TLS, OIDC/JWT, per-tenant rate limits" style="html=1;fontFamily=DejaVu Sans;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#3C4043;fontColor=#1A1A1A;dashed=0;fontSize=11.5;" vertex="1" parent="1"><mxGeometry x="356" y="110" width="720" height="84" as="geometry"/></mxCell><mxCell id="c6" value="deploy/overlays/production/gateway" style="html=1;fontFamily=DejaVu Sans;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#C4C7CA;fontColor=#5F6368;dashed=1;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1092" y="110" width="268" height="84" as="geometry"/></mxCell><mxCell id="c7" value="Control plane" style="html=1;fontFamily=DejaVu Sans;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#EEF6E0;strokeColor=#76B900;fontColor=#3F6300;dashed=0;fontSize=14;