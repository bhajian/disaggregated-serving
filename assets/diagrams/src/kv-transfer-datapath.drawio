<mxfile host="tools/render_diagrams.py"><diagram name="KV transfer datapath between nodes"><mxGraphModel dx="1400" dy="600" grid="1" gridSize="10" page="1" pageWidth="1400" pageHeight="600" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="KV transfer datapath between nodes" style="html=1;fontFamily=Inter;whiteSpace=wrap;text;fontSize=28.0;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1320" height="30" as="geometry"/></mxCell><mxCell id="c3" value="GPUDirect RDMA moves KV pages from prefill HBM to decode HBM without a host copy. Staging through host memory works but is slower." style="html=1;fontFamily=Inter;whiteSpace=wrap;text;fontSize=16.8;fontColor=#5F6368;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1320" height="24" as="geometry"/></mxCell><mxCell id="c4" value="Prefill node" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#C4C7CA;dashed=1;verticalAlign=top;align=left;spacingLeft=14;fontStyle=1;fontSize=15.4;fontColor=#5F6368;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="520" height="400" as="geometry"/></mxCell><mxCell id="c5" value="Decode node" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#C4C7CA;dashed=1;verticalAlign=top;align=left;spacingLeft=14;fontStyle=1;fontSize=15.4;fontColor=#5F6368;" vertex="1" parent="1"><mxGeometry x="840" y="100" width="520" height="400" as="geometry"/></mxCell><mxCell id="c6" value="SGLang / vLLM → NIXL → UCX (rc, cuda_copy, cuda_ipc)" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#F3F4F5;strokeColor=#C4C7CA;fontColor=#1A1A1A;dashed=0;fontSize=15.4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="150" width="460" height="60" as="geometry"/></mxCell><mxCell id="c7" value="GPU HBM&#xa;KV pages" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=6;fi