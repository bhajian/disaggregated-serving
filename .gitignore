.venv/
__pycache__/
.pytest_cache/
.ipynb_checkpoints/
build/
results/*/
results/*.csv
# Retain the completed 256K comparison and its supporting evidence.
!results/deepseek-v4-pro-256k-comparison/
!results/deepseek-v4-pro-256k-comparison/**
!results/nemotron-3-nano-128k-comparison/
!results/nemotron-3-nano-128k-comparison/**
!results/nemotron-3-nano-8k-128k-comparison/
!results/nemotron-3-nano-8k-128k-comparison/**
# Raw per-token interval binaries (hundreds of MB per run) stay on the client PVC.
results/**/intervals-*.f32
# Generated benchmark datasets (including the 256K-context comparison).
datasets/generated/
*.env
!*.env.example

# Site values and rendered site manifests stay local.
deployments/site.env

# Raw result evidence lives in release archives (results/ARCHIVE.md).
results/**/*.prom
results/**/*.jsonl
results/**/*.log
results/**/*.png
results/**/*.executed.ipynb
